#!/bin/bash
# Runs commands for updating various parts of the system.

exists() {
  command -v $1 > /dev/null
}

# TODO: Figure out permissions
# if exists port; then
#     echo MacPorts
#     sudo port selfupdate
#     sudo port upgrade outdated
# fi

if exists gem; then
    echo Gem
    gem update --system
    gem update
fi

if exists npm; then
    echo npm
    npm update --global
fi

if exists rustup; then
    echo Rust
    rustup update
fi

if exists code; then
    code --update-extensions
fi
